# Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Vercel Cron (keep-alive) — যেকোনো random string, Vercel-এ same value env হিসেবে দিন
CRON_SECRET=change-me-to-a-long-random-string

# Site URL (auth redirect-এর জন্য); local-এ http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://diabetes-zeta-wine.vercel.app
